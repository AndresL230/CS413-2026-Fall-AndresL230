# factorial(5) = 120
# fix fact(n). if n <= 0 then 1 else n * fact(n - 1)
D0Eapp(
    D0Efix("fact", "n",
        D0Eif0(
            D0Eop2("<=", D0Evar("n"), D0Eint(0)),
            D0Eint(1),
            D0Eop2("*", D0Evar("n"),
                D0Eapp(D0Evar("fact"), D0Eop1("-1", D0Evar("n")))))),
    D0Eint(5))
